# --- Core ---
# PostgreSQL connection string.
# Local (Docker Compose, host port 5433):  postgresql://postgres:postgres@localhost:5433/society_db
# Neon (production, pooled):               postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/society_db

# Neon direct (unpooled) string - used by alembic migrations only (optional locally)
DATABASE_URL_UNPOOLED=

# Auth
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Complaints / SLA
OVERDUE_THRESHOLD_DAYS=3

# --- Infrastructure ---
REDIS_URL=redis://localhost:6379/0

# Job execution: celery (dev, uses Redis+workers) | inline (prod fallback)
JOB_EXECUTION_MODE=inline

# CORS origin of the deployed frontend (comma-separated allowed origins)
FRONTEND_ORIGIN=http://localhost:5173

# Base URL used to build password-reset links (frontend URL in prod)
FRONTEND_URL=http://localhost:5173

# Shared secret required by POST /api/internal/jobs/* endpoints (external cron)
CRON_SECRET=

# --- File storage: local | cloudinary ---
STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (Razorpay) - blank = simulated payment flow ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend) - blank = emails logged/stored only ---
RESEND_API_KEY=
EMAIL_FROM=Society Maintenance <onboarding@resend.dev>
